# =============================
# OXM 製造業平台 環境變數範本
# 複製此檔案為 .env，填入實際值後啟動
# =============================

# ── 資料庫 ──────────────────────
# 格式：mysql://帳號:密碼@主機:埠號/資料庫名稱
DATABASE_URL=mysql://root:yourpassword@localhost:3306/oxm

# ── Node 環境 ────────────────────
NODE_ENV=production

# ── Session / JWT ───────────────
# 上線前必須換成強密碼（至少 64 字元隨機字串）
# 生成指令：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=請替換成64字元以上的隨機字串

# ── Google OAuth ────────────────
# 到 Google Cloud Console > APIs & Services > Credentials 取得
# Authorized redirect URI: https://www.oxmmatch.com/api/oauth/callback
GOOGLE_CLIENT_ID=你的Google_Client_ID
GOOGLE_CLIENT_SECRET=你的Google_Client_Secret

# ── Apple OAuth ──────────────────
# 到 Apple Developer > Certificates > Identifiers > Services IDs 設定
# Redirect URI: https://www.oxmmatch.com/api/oauth/apple/callback
APPLE_CLIENT_ID=com.yourcompany.oxm
APPLE_TEAM_ID=XXXXXXXXXX
APPLE_KEY_ID=XXXXXXXXXX
# P8 私鑰內容（換行用 \n 表示），每 6 個月需重新產生
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
APPLE_REDIRECT_URI=https://www.oxmmatch.com/api/oauth/apple/callback

# ── LINE OAuth ───────────────────
# 到 LINE Developers Console > LINE Login channel 設定
# Callback URL: https://www.oxmmatch.com/api/oauth/line/callback
LINE_CHANNEL_ID=1234567890
LINE_CHANNEL_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LINE_REDIRECT_URI=https://www.oxmmatch.com/api/oauth/line/callback

# ── 安全 / CORS ──────────────────
# 填入正式網域，多個網域用逗號分隔
# 範例：ALLOWED_ORIGINS=https://oxm.com.tw
ALLOWED_ORIGINS=https://你的網域.com

# ── 管理員白名單 ─────────────────
# JSON 陣列格式，填入管理員的 Google 登入 Email
ADMIN_WHITELIST_EMAILS=["admin@example.com"]

# ── Email 通知（Resend）──────────
# 申請：https://resend.com
# 若未填入，Email 通知功能將無法運作（不影響其他功能）
RESEND_API_KEY=
FROM_EMAIL=noreply@你的網域.com

# ── AI 語意搜尋（Anthropic）──────
# 申請：https://console.anthropic.com
# 若未填入，搜尋將 fallback 為普通關鍵字搜尋（不影響上線）
ANTHROPIC_API_KEY=

# ── 圖片儲存（AWS S3，公開圖片專用）──
# 若未填入，圖片將以 base64 暫存在 DB（不建議正式環境使用）
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-1
AWS_S3_BUCKET=你的bucket名稱

# ── 找消息 PDF 附件儲存（AWS S3，私有 Bucket 專用）──
# 跟上面「圖片儲存」完全獨立的 bucket 與憑證，不共用、不互相 fallback。
# 四項缺一即視為未設定，PDF 附件上傳／下載功能會回傳「私有附件儲存尚未
# 設定」並拒絕執行，不影響公開圖片功能。bucket 需開啟 Block Public Access，
# 對應 IAM 使用者僅需 s3:GetObject／s3:PutObject／s3:DeleteObject，
# Resource 限定在該 bucket 的 news-attachments/* 前綴。
AWS_PRIVATE_FILES_ACCESS_KEY_ID=
AWS_PRIVATE_FILES_SECRET_ACCESS_KEY=
AWS_PRIVATE_FILES_BUCKET=
AWS_PRIVATE_FILES_REGION=ap-northeast-1

# ── Server Port（選填）──────────
# 預設 3000
PORT=3000
